<!DOCTYPE html><html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Card</title><style>
    /* Box sizing */
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #eef2f8;
    }

    /* Sticky top bar */
    header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #12203a;
        color: white;
        padding: 14px;
        text-align: center;
    }

    /* Profile card */
    .card {
        width: 280px;
        margin: 24px auto;
        background: white;
        border: 2px solid #2f5bea;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
    }

    /* Round avatar */
    .avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #2f5bea;
        color: white;
        font-size: 36px;
        line-height: 90px;
        margin: 0 auto 10px;
    }

    /* Scrollable bio */
    .bio {
        height: 80px;
        overflow: auto;
        text-align: left;
        border: 1px solid #ccd;
        padding: 8px;
        margin-top: 12px;
        font-size: 14px;
    }

    /* Second card colour */
    .card-two {
        border-color: #e75480;
    }

    .avatar-two {
        background: #e75480;
    }

    /* Fixed floating button */
    .fab {
        position: fixed;
        right: 16px;
        bottom: 16px;
        width: 52px;
        height: 52px;
        border: 0;
        border-radius: 50%;
        background: #ffb703;
        font-size: 26px;
        cursor: pointer;
        z-index: 20;
    }
</style>

</head><body><header>
    <h2>My Profile Page</h2>
</header>

<!-- First profile card -->
<div class="card">
    <div class="avatar">R</div>

    <h2>Rinjham Bhatia</h2>
    <p>BTech CSE AI Student</p>

    <div class="bio">
        Hello! I am Rinjham. I am a first-year student learning HTML,
        CSS, Java and web development. I enjoy learning new technologies
        and creating websites. My goal is to become a skilled developer.
        I want to build useful projects and improve my coding skills.
    </div>
</div>

<!-- Second profile card with different colours -->
<div class="card card-two">
    <div class="avatar avatar-two">R</div>

    <h2>My Learning Journey</h2>
    <p>Future Developer</p>

    <div class="bio">
        I am learning programming step by step. I practise HTML,
        CSS and Java to understand how websites and applications work.
        I will continue building projects and improving my skills.
    </div>
</div>

<!-- Floating plus button -->
<button class="fab" aria-label="Add profile">+</button>

</body>
</html>
